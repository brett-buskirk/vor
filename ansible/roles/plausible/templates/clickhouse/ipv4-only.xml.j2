<!--
  vor — ClickHouse IPv4-only listener  ·  RENDERED BY ANSIBLE
  Mounted at /etc/clickhouse-server/config.d/ipv4-only.xml. Binds ClickHouse to
  IPv4 only, avoiding startup errors on droplets without IPv6. ClickHouse still
  stays on the internal Docker network (never published).
  Verbatim from plausible/community-edition, verified 2026-07.
-->
<clickhouse>
    <listen_host>0.0.0.0</listen_host>
</clickhouse>

<!--
  vor — ClickHouse IPv4-only listener for Plausible
  Mounted at /etc/clickhouse-server/config.d/ipv4-only.xml
  Binds ClickHouse to IPv4 only, avoiding startup errors on droplets without
  IPv6. ClickHouse still stays on the internal Docker network (never published).
  TODO(vor): verify against upstream:
  https://github.com/plausible/community-edition/blob/master/clickhouse/ipv4-only.xml
-->
<clickhouse>
    <listen_host>0.0.0.0</listen_host>
</clickhouse>

# =============================================================================
# vor — Caddyfile (example)
# =============================================================================
# THE SECURITY CENTERPIECE OF THE STACK. Read the whole file before editing.
#
# Copy to `Caddyfile`. It defines TWO sites that both proxy the same Plausible
# app (plausible:8000) but expose very different surfaces:
#
#   1. PUBLIC site   — {$ANALYTICS_DOMAIN}, world-reachable on :80/:443 (bound to
#                      the droplet's PUBLIC IP in docker-compose.yml). Serves ONLY
#                      the tracking script (/js/*) and the event API (/api/event);
#                      everything else returns 404. TLS via Let's Encrypt (ACME).
#
#   2. DASHBOARD site — the admin UI (/, /login, /settings, the stats pages, …).
#                      Caddy serves it on :8443, which docker-compose.yml publishes
#                      ONLY on the droplet's TAILSCALE IP. Reachable solely from
#                      devices on the same tailnet; never from the public internet.
#
# Why the split: visitors on tracked sites must POST events to a public URL, but
# the dashboard must NOT be public. Splitting by path on the public hostname and
# binding the dashboard listener to the Tailscale IP gives public ingestion with
# a private admin surface — the defining design decision of vor.
#
# The public/private boundary is enforced in TWO independent layers:
#   - here (Caddy only serves /js/* + /api/event on the public hostname), and
#   - in docker-compose.yml (the :8443 dashboard listener is published only on
#     the Tailscale IP, so the OS never routes public traffic to it at all).
#
# Validate before deploying:
#   docker run --rm -e ANALYTICS_DOMAIN=analytics.example.com \
#     -e ACME_EMAIL=admin@example.com \
#     -v "$PWD/Caddyfile:/etc/caddy/Caddyfile:ro" \
#     caddy:2-alpine caddy validate --config /etc/caddy/Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# Global options
# -----------------------------------------------------------------------------
{
	# ACME contact for the public certificate (set via {$ACME_EMAIL} in compose).
	email {$ACME_EMAIL}
}

# -----------------------------------------------------------------------------
# 1) PUBLIC ingestion site — only /js/* and /api/event are exposed
# -----------------------------------------------------------------------------
# Listens on the public 80/443 (bound to the droplet's public IP in compose).
# Caddy auto-provisions a Let's Encrypt cert for {$ANALYTICS_DOMAIN}.
{$ANALYTICS_DOMAIN} {
	# While testing, point ACME at Let's Encrypt staging to avoid burning the
	# strict production rate limits, then remove this block for the real cert.
	# Keep it scoped to THIS site — a global acme_ca would create a default
	# issuer policy that conflicts with the dashboard's `tls internal` below.
	# tls {
	# 	ca https://acme-staging-v02.api.letsencrypt.org/directory
	# }

	# Match ONLY the public surface: the tracking script and the event API.
	# /js/*        — script.js and its extension variants (outbound-links, etc.)
	# /api/event   — the ingestion endpoint every visitor's browser POSTs to
	@public path /js/* /api/event /api/event/

	handle @public {
		reverse_proxy plausible:8000
	}

	# Everything else on the public hostname is refused — the dashboard, login,
	# settings, and stats API live on the Tailscale site below and must never be
	# reachable from the public internet. Return 404 (not 403) so the public
	# surface gives nothing away about what else is running here.
	handle {
		respond "Not found" 404
	}
}

# -----------------------------------------------------------------------------
# 2) ADMIN dashboard site — Tailscale-only, the full app
# -----------------------------------------------------------------------------
# Caddy listens on :8443 here; docker-compose.yml publishes that port ONLY on
# the droplet's Tailscale IP, so this site is reachable solely over the tailnet.
#
# TLS uses Caddy's internal CA (self-signed root) because this listener has no
# publicly resolvable hostname — your browser will prompt to trust it once, or
# you can install Caddy's root CA. For a trusted cert over Tailscale instead,
# use the droplet's MagicDNS name as the site address and the Caddy Tailscale
# plugin (see the commented block below).
:8443 {
	tls internal

	# The full Plausible app — dashboard, login, settings, stats API, everything.
	reverse_proxy plausible:8000
}

# Optional: reach the dashboard by a trusted, friendly name over Tailscale.
# Replace the ":8443" block above with your droplet's MagicDNS hostname and let
# the Caddy Tailscale plugin issue a real cert (requires a plugin-enabled image):
#
# vor-analytics.<your-tailnet>.ts.net {
# 	tls {
# 		get_certificate tailscale
# 	}
# 	reverse_proxy plausible:8000
# }

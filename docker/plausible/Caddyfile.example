# =============================================================================
# vor — Caddyfile (example / skeleton)
# =============================================================================
# THIS IS THE TRICKIEST PIECE OF THE STACK. Read the whole file before editing.
#
# Copy to `Caddyfile` and adjust. It defines TWO separate sites that both proxy
# to the same Plausible app (plausible:8000) but expose very different surfaces:
#
#   1. PUBLIC site  — {$ANALYTICS_DOMAIN}, world-reachable on :80/:443.
#                     Serves ONLY the tracking script (/js/*) and the event API
#                     (/api/event). Everything else returns 404. TLS via ACME.
#
#   2. DASHBOARD site — the admin UI (/, /login, /settings, …). Bound to the
#                     TAILSCALE interface only (published on the tailnet IP in
#                     docker-compose.yml), served on Caddy's internal :8443.
#                     Reachable ONLY from devices on the same tailnet.
#
# Why the split: visitors on tracked sites must POST events to a public URL, but
# the dashboard must NOT be public. Splitting by path on the public hostname and
# binding the dashboard to Tailscale gives public ingestion + private admin.
#
# TODO(vor): validate this against `caddy validate` and a real deploy — path
# matchers, the 404 fallthrough, and the Tailscale listener are the bits most
# likely to need tuning for the current Plausible version.
# =============================================================================

# -----------------------------------------------------------------------------
# Global options
# -----------------------------------------------------------------------------
{
	# ACME contact for the public certificate. TODO(vor): set via {$ACME_EMAIL}.
	email {$ACME_EMAIL}
	# TODO(vor): while testing, point ACME at Let's Encrypt staging to avoid
	# rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# -----------------------------------------------------------------------------
# 1) PUBLIC ingestion site — only /js/* and /api/event are exposed
# -----------------------------------------------------------------------------
# Listens on the public 80/443 (bound to the droplet's public IP in compose).
# Caddy auto-provisions a Let's Encrypt cert for {$ANALYTICS_DOMAIN}.
{$ANALYTICS_DOMAIN} {
	# Match ONLY the public surface: the tracking script and the event API.
	@public {
		path /js/* /api/event /api/event/
	}
	handle @public {
		reverse_proxy plausible:8000
	}

	# Optional: expose a health endpoint for uptime checks.
	# handle /api/health {
	# 	reverse_proxy plausible:8000
	# }

	# Everything else on the public hostname is NOT served here (the dashboard
	# lives on the Tailscale site below). Return 404 so the admin UI, login, and
	# settings are never reachable from the public internet.
	handle {
		respond "Not found" 404
	}
}

# -----------------------------------------------------------------------------
# 2) ADMIN dashboard site — Tailscale-only, full app
# -----------------------------------------------------------------------------
# Caddy listens on :8443 here; docker-compose.yml publishes that port ONLY on
# the droplet's Tailscale IP, so this site is reachable solely over the tailnet.
#
# TLS uses Caddy's internal CA (self-signed root) since this hostname isn't
# publicly resolvable. TODO(vor): consider Tailscale-issued certs instead:
#   tls { get_certificate tailscale }   # requires the Caddy Tailscale plugin
:8443 {
	tls internal

	# The full Plausible app — dashboard, login, settings, API, everything.
	reverse_proxy plausible:8000

	# TODO(vor): if you want to reach this by a friendly name, use the droplet's
	# MagicDNS hostname (e.g. https://vor-analytics.<tailnet>.ts.net) as the site
	# address instead of :8443 and let Tailscale/Caddy handle the cert.
}

# =============================================================================
# vor — Plausible Configuration (example)
# =============================================================================
# Copy to plausible-conf.env and fill in real values. NEVER commit the real
# file — it holds secrets. Only this *.example is tracked.
#
# Reference: https://github.com/plausible/community-edition (configuration docs)
# =============================================================================

# -----------------------------------------------------------------------------
# Core (required)
# -----------------------------------------------------------------------------
# Public URL of this instance — must match analytics_domain / the Caddy public
# site, including https://
BASE_URL=https://analytics.example.com

# Secret used to sign sessions/tokens. Plausible requires >= 64 bytes. Generate:
#   openssl rand -base64 64
SECRET_KEY_BASE=REPLACE_ME_openssl_rand_base64_64

# Vault key for encrypting 2FA/TOTP secrets at rest. Generate with:
#   openssl rand -base64 32
TOTP_VAULT_KEY=REPLACE_ME_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Database connections (internal Docker network hostnames)
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD initializes the Postgres superuser; the plausible_db service
# reads it from this same file (via env_file). It MUST match the password
# embedded in DATABASE_URL below — set both to the same strong value.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://postgres:CHANGE_ME_STRONG_PASSWORD@plausible_db:5432/plausible_db
CLICKHOUSE_DATABASE_URL=http://plausible_events_db:8123/plausible_events_db

# -----------------------------------------------------------------------------
# Registration / access
# -----------------------------------------------------------------------------
# BOOTSTRAP: Community Edition has no create-user CLI. To make your FIRST admin,
# set this to `false`, deploy, and register at the dashboard over Tailscale (the
# public site never serves the registration page). Then set it back to
# `invite_only` (lets you invite teammates later) or `true` (fully closed) and
# re-deploy. See CUSTOMIZATION.md, Step 5. Values: true | false | invite_only.
DISABLE_REGISTRATION=true

# -----------------------------------------------------------------------------
# Email / SMTP (placeholders — required for invites, password resets, reports)
# -----------------------------------------------------------------------------
# TODO(vor): point these at your SMTP provider (Mailgun, SendGrid, Postmark, …).
MAILER_ADAPTER=Bamboo.SMTPAdapter
MAILER_EMAIL=analytics@example.com
SMTP_HOST_ADDR=smtp.example.com
SMTP_HOST_PORT=587
SMTP_USER_NAME=your_smtp_username
SMTP_USER_PWD=your_smtp_password
SMTP_HOST_SSL_ENABLED=false

# --- OS / editor noise ---
.DS_Store
*.log
*.swp

# --- Secrets & credentials — NEVER commit these ---
# Only *.example variants are tracked.
*.tfvars
!*.tfvars.example
.env
.env.*
!.env.example
plausible-conf.env
!plausible-conf.env.example
*.pem
*.key
*.p12
*_rsa
*_ed25519
tailscale-authkey*

# --- Rendered stack config (only *.example is tracked) ---
# The live Caddyfile is copied/rendered from Caddyfile.example (locally, in CI,
# or by Ansible) and must never be committed.
docker/plausible/Caddyfile

# --- Terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json

# --- Ansible ---
# Real inventory + group vars hold per-deployment values; only the *.example
# variants are tracked. Copy each to its real name and fill it in.
ansible/inventory/manual.yml
ansible/inventory/group_vars/all.yml
ansible/inventory/*.retry
*.retry
# Vendored Galaxy roles (installed via `ansible-galaxy install -r
# ansible/requirements.yml`) — pulled on demand, never committed.
ansible/roles/brett-buskirk.*

# --- Runtime data / backups ---
docker/plausible/clickhouse-data/
docker/plausible/postgres-data/
backups/
*.dump
*.sql.gz
